    function validateWiring() {
        const simulationEngine =
            discoverSimulationEngine();

        const recommendedActions =
            discoverRecommendedActionsEngine();

        const setup =
            readSystemSetup();

        const validation = {
            module:
                MODULE_NAME,

            version:
                VERSION,

            simulationEngineConnected:
                !!simulationEngine,

            simulationEngineVersion:
                SIMULATION_ENGINE_VERSION,

            recommendedActionsConnected:
                !!recommendedActions,

            recommendedActionsVersion:
                recommendedActions?.version ||
                RECOMMENDED_ACTIONS_VERSION,

            positioningMode:
                setup.positioningMode,

            engineLoadMode:
                setup.engineLoadMode,

            pushUpIsPositioningBias:
                false,

            reserveVerificationRequiredForPushUp:
                true,

            humanAuthority:
                HUMAN_AUTHORITY,

            autonomousCommand:
                false,

            realVesselConnection:
                false,

            safetyBoundary:
                SAFETY_BOUNDARY,

            pipeline:
                PIPELINE.slice()
        };

        log(
            "WIRING VALIDATION:",
            validation
        );

        setText(
            [
                "engineStatus",
                "liveEngineStatus"
