/*
============================================================
SEXTANT PROTOCOL™
DP RESILIENCE V&V RESEARCH COCKPIT
============================================================

FILE:
dp_cockpit.js

VERSION:
2.5.1

PURPOSE:
Browser-side controller for the deterministic DP resilience
research / V&V cockpit.

ARCHITECTURE:
ENVIRONMENT
    ↓
PRIMARY AI
    ↓
SECONDARY AI
    ↓
STABILIZER
    ↓
RECOMMENDED ACTIONS ENGINE
    ↓
RESERVE-POWER VERIFICATION
    ↓
HUMAN-IN-THE-LOOP
    ↓
SIMULATED DP RESPONSE

SAFETY BOUNDARY:
SIMULATION ONLY — NO AUTONOMOUS OPERATIONAL COMMAND

CRITICAL DISTINCTION:
BIAS     = POSITIONING MODE ONLY
PUSH-UP  = ENGINE LOAD COMPENSATION ONLY
PUSH-UP ≠ POSITIONING BIAS

PUSH-UP SAFETY:
PUSH-UP REQUIRES AUTHORITATIVE RESERVE-POWER
VERIFICATION.

UNKNOWN / UNVERIFIED RESERVE:
NOT SUFFICIENT FOR PUSH-UP.

HUMAN AUTHORITY:
FINAL

REAL VESSEL:
NO

AUTONOMOUS COMMAND:
NO

CERTIFICATION:
NOT CERTIFIED

============================================================
*/

(function () {
    "use strict";

    /* ========================================================
       MODULE CONSTANTS
    ======================================================== */

    const MODULE_NAME = "SextantDPResilienceCockpit";
    const VERSION = "2.5.1";

    const SIMULATION_ENGINE_VERSION = "1.2.0";
    const RECOMMENDED_ACTIONS_VERSION =
        "SPD-DP-RECOMMENDED-ACTIONS-V1.2";

    const SAFETY_BOUNDARY =
        "SIMULATION ONLY — NO AUTONOMOUS OPERATIONAL COMMAND";

    const AUTONOMOUS_COMMAND = false;
    const REAL_VESSEL_CONNECTION = false;
    const HUMAN_AUTHORITY = "FINAL";

    const POSITIONING_MODES = {
        NON_BIAS: "NON_BIAS",
        BIAS: "BIAS"
    };

    const ENGINE_LOAD_MODES = {
        NORMAL: "NORMAL",
        PUSH_UP: "PUSH_UP"
    };

    const PIPELINE = [
        "ENVIRONMENT",
        "SYSTEM SETUP",
        "S1 PRIMARY AI",
        "S2 SECONDARY AI",
        "STABILIZER",
        "RECOMMENDED ACTIONS ENGINE",
        "RESERVE-POWER VERIFICATION",
        "HUMAN-IN-THE-LOOP",
        "SIMULATED DP RESPONSE"
    ];


    /* ========================================================
       BASIC DOM HELPERS
    ======================================================== */

    function byId(id) {
        return document.getElementById(id);
    }

    function firstById(ids) {
        for (let i = 0; i < ids.length; i++) {
            const el = byId(ids[i]);
            if (el) return el;
        }
        return null;
    }

    function setText(ids, value) {
        const el = firstById(
            Array.isArray(ids) ? ids : [ids]
        );

        if (el) {
            el.textContent =
                value === undefined || value === null
                    ? ""
                    : String(value);
        }
    }

    function setValue(ids, value) {
        const el = firstById(
            Array.isArray(ids) ? ids : [ids]
        );

        if (el) {
            el.value = value;
            return true;
        }

        return false;
    }

    function getValue(ids, fallback) {
        const el = firstById(
            Array.isArray(ids) ? ids : [ids]
        );

        if (!el) return fallback;

        return el.value;
    }

    function parseNumber(ids, fallback) {
        const value = Number(
            getValue(ids, fallback)
        );

        return Number.isFinite(value)
            ? value
            : fallback;
    }

    function safeJSON(value) {
        try {
            return JSON.stringify(
                value,
                null,
                2
            );
        } catch (error) {
            return String(value);
        }
    }

    function log(message, data) {
        if (data !== undefined) {
            console.log(
                "[Sextant DP Cockpit]",
                message,
                data
            );
        } else {
            console.log(
                "[Sextant DP Cockpit]",
                message
            );
        }
    }


    /* ========================================================
       SAFETY DISPLAY
    ======================================================== */

    function displaySafety() {
        setText(
            [
                "safetyBoundary",
                "liveSafetyBoundary",
                "safetyStatus"
            ],
            SAFETY_BOUNDARY
        );

        setText(
            [
                "autonomousCommand",
                "liveAutonomousCommand"
            ],
            "FALSE — NO AUTONOMOUS COMMAND"
        );

        setText(
            [
                "humanAuthority",
                "liveHumanAuthority"
            ],
            "FINAL"
        );
    }


    /* ========================================================
       ENGINE DISCOVERY
    ======================================================== */

    function discoverSimulationEngine() {
        const candidates = [
            "DPSimulationEngine",
            "DPSimulatorEngine",
            "DPResilienceEngine",
            "dpSimulationEngine",
            "dpEngine"
        ];

        for (let i = 0; i < candidates.length; i++) {
            const candidate =
                window[candidates[i]];

            if (
                candidate &&
                typeof candidate.run === "function"
            ) {
                return candidate;
            }
        }

        return null;
    }


    /* ========================================================
       RECOMMENDED ACTIONS ENGINE DISCOVERY
    ======================================================== */

    function discoverRecommendedActionsEngine() {
        if (
            window.DPRecommendedActions &&
            typeof window.DPRecommendedActions.generate === "function"
        ) {
            return window.DPRecommendedActions;
        }

        return null;
    }

    function retryRecommendedActionsEngine() {
        const engine =
            discoverRecommendedActionsEngine();

        if (engine) {
            log(
                "RECOMMENDED ACTIONS ENGINE CONNECTED",
                engine.version ||
                RECOMMENDED_ACTIONS_VERSION
            );
        } else {
            log(
                "RECOMMENDED ACTIONS ENGINE NOT YET DETECTED"
            );
        }

        return engine;
    }


    /* ========================================================
       SYSTEM SETUP
       ======================================================== */

    function readSystemSetup() {
        let positioningMode =
            getValue(
                [
                    "positioningMode",
                    "positionMode",
                    "biasMode"
                ],
                POSITIONING_MODES.NON_BIAS
            );

        let engineLoadMode =
            getValue(
                [
                    "engineLoadMode",
                    "loadMode",
                    "engineMode"
                ],
                ENGINE_LOAD_MODES.NORMAL
            );

        if (
            positioningMode !== POSITIONING_MODES.BIAS &&
            positioningMode !== POSITIONING_MODES.NON_BIAS
        ) {
            positioningMode =
                POSITIONING_MODES.NON_BIAS;
        }

        if (
            engineLoadMode !== ENGINE_LOAD_MODES.PUSH_UP &&
            engineLoadMode !== ENGINE_LOAD_MODES.NORMAL
        ) {
            engineLoadMode =
                ENGINE_LOAD_MODES.NORMAL;
        }

        return {
            positioningMode,
            engineLoadMode
        };
    }


    function updateSystemSetupDisplay(setup) {
        const current =
            setup || readSystemSetup();

        const positioningLabel =
            current.positioningMode ===
            POSITIONING_MODES.BIAS
                ? "BIAS — POSITIONING MODE"
                : "NON-BIAS — STANDARD POSITIONING";

        const loadLabel =
            current.engineLoadMode ===
            ENGINE_LOAD_MODES.PUSH_UP
                ? "PUSH-UP — ENGINE LOAD COMPENSATION"
                : "NORMAL — NOMINAL ENGINE LOAD";

        setText(
            "livePositioningMode",
            current.positioningMode
        );

        setText(
            "liveEngineLoadMode",
            current.engineLoadMode
        );

        setText(
            [
                "positioningModeStatus",
                "positioningStatus"
            ],
            positioningLabel
        );

        setText(
            [
                "engineLoadModeStatus",
                "engineLoadStatus"
            ],
            loadLabel
        );

        setText(
            [
                "setupDistinction",
                "modeDistinction"
            ],
            "POSITIONING BIAS/NON-BIAS IS SEPARATE FROM ENGINE LOAD NORMAL/PUSH-UP"
        );

        log(
            "POSITIONING MODE:",
            current.positioningMode
        );

        log(
            "ENGINE LOAD MODE:",
            current.engineLoadMode
        );

        log(
            "PUSH-UP ≠ POSITIONING BIAS"
        );

        return current;
    }


    /* ========================================================
       ENVIRONMENT
    ======================================================== */

    function readEnvironment() {
        const setup =
            readSystemSetup();

        return {
            wind: parseNumber(
                [
                    "wind",
                    "windSpeed",
                    "windForce"
                ],
                0
            ),

            current: parseNumber(
                [
                    "current",
                    "currentSpeed",
                    "currentForce"
                ],
                0
            ),

            wave: parseNumber(
                [
                    "wave",
                    "waveHeight",
                    "waveForce"
                ],
                0
            ),

            tidal: parseNumber(
                [
                    "tidal",
                    "tide",
                    "tidalForce"
                ],
                0
            ),

            positioningMode:
                setup.positioningMode,

            engineLoadMode:
                setup.engineLoadMode
        };
    }


    /* ========================================================
       ENVIRONMENT DISPLAY
    ======================================================== */

    function updateEnvironmentDisplay(environment) {
        if (!environment) return;

        setText(
            ["liveWind", "displayWind"],
            environment.wind
        );

        setText(
            ["liveCurrent", "displayCurrent"],
            environment.current
        );

        setText(
            ["liveWave", "displayWave"],
            environment.wave
        );

        setText(
            ["liveTidal", "displayTidal"],
            environment.tidal
        );

        setText(
            "environmentStatus",
            "INPUTS RECEIVED"
        );
    }


    /* ========================================================
       AUTHORITATIVE ENGINE EXECUTION
    ======================================================== */

    function executeEngine(environment) {
        const engine =
            discoverSimulationEngine();

        if (!engine) {
            throw new Error(
                "DP Simulation Engine is not connected."
            );
        }

        if (
            typeof engine.run !== "function"
        ) {
            throw new Error(
                "DP Simulation Engine does not expose run()."
            );
        }

        log(
            "EXECUTING AUTHORITATIVE DP SIMULATION ENGINE"
        );

        const result =
            engine.run(environment);

        return result;
    }


    /* ========================================================
       RECOMMENDED ACTIONS
    ======================================================== */

    function executeRecommendedActions(result) {
        if (!result) {
            return null;
        }

        /*
         * Prefer authoritative recommendations returned
         * by the simulation result.
         */
        if (
            result.recommendedActions
        ) {
            return result.recommendedActions;
        }

        if (
            result.recommendations
        ) {
            return result.recommendations;
        }

        const actions =
            discoverRecommendedActionsEngine();

        if (
            actions &&
            typeof actions.generate === "function"
        ) {
            return actions.generate(result);
        }

        return null;
    }


    /* ========================================================
       RESERVE-POWER VERIFICATION
       ======================================================== */

    function extractReserveVerification(result) {
        if (!result) {
            return {
                reserveVerified: false,
                availableReserve: null,
                requiredReserve: null,
                status: "NOT VERIFIED",
                verificationSource:
                    "NO SIMULATION RESULT"
            };
        }

        const reserve =
            result.reservePowerVerification ||
            result.reserveVerification ||
            null;

        if (!reserve) {
            return {
                reserveVerified: false,
                availableReserve: null,
                requiredReserve: null,
                status: "NOT VERIFIED",
                verificationSource:
                    "NO AUTHORITATIVE RESERVE RESULT"
            };
        }

        return {
            reserveVerified:
                reserve.reserveVerified === true,

            availableReserve:
                reserve.availableReserve !== undefined
                    ? reserve.availableReserve
                    : null,

            requiredReserve:
                reserve.requiredReserve !== undefined
                    ? reserve.requiredReserve
                    : null,

            status:
                reserve.status ||
                (
                    reserve.reserveVerified === true
                        ? "VERIFIED"
                        : "NOT VERIFIED"
                ),

            verificationSource:
                reserve.verificationSource ||
                "AUTHORITATIVE DP SIMULATION ENGINE"
        };
    }


    function updateReservePowerDisplay(
        reserveVerification
    ) {
        const reserve =
            reserveVerification || {
                reserveVerified: false,
                availableReserve: null,
                requiredReserve: null,
                status: "NOT VERIFIED"
            };

        const verified =
            reserve.reserveVerified === true;

        const available =
            reserve.availableReserve;

        const required =
            reserve.requiredReserve;

        setText(
            [
                "liveReserve",
                "reserveVerification"
            ],
            verified
                ? "VERIFIED"
                : "NOT VERIFIED"
        );

        setText(
            "reserveStatus",
            reserve.status ||
            (verified
                ? "VERIFIED"
                : "NOT VERIFIED")
        );

        setText(
            [
                "availableReserve",
                "reserveAvailable"
            ],
            available === null ||
            available === undefined
                ? "—"
                : Number(available).toFixed(2)
        );

        setText(
            [
                "requiredReserve",
                "reserveRequired"
            ],
            required === null ||
            required === undefined
                ? "—"
                : Number(required).toFixed(2)
        );

        setText(
            [
                "reserveGate",
                "reservePowerGate"
            ],
            verified
                ? "RESERVE VERIFIED"
                : "NOT VERIFIED"
        );

        log(
            "RESERVE-POWER VERIFICATION:",
            verified
                ? "VERIFIED"
                : "NOT VERIFIED"
        );
    }


    /* ========================================================
       ASSESSMENT DISPLAY
    ======================================================== */

    function updateAssessment(
        result,
        actions,
        reserveVerification,
        setup
    ) {
        if (!result) return;

        const assessment =
            result.assessment ||
            result;

        const risk =
            assessment.risk ||
            assessment.riskLevel ||
            result.risk ||
            "—";

        setText(
            [
                "riskLevel",
                "assessmentRisk",
                "risk"
            ],
            risk
        );

        setText(
            [
                "primaryMode",
                "assessmentPrimaryMode"
            ],
            result.primaryState ||
            result.primaryMode ||
            "—"
        );

        setText(
            [
                "secondaryMode",
                "assessmentSecondaryMode"
            ],
            result.secondaryState ||
            result.secondaryMode ||
            "—"
        );

        setText(
            [
                "stabilizerMode",
                "assessmentStabilizerMode"
            ],
            result.stabilizerMode ||
            result.stabilizer ||
            "—"
        );

        setText(
            [
                "assessmentOutput",
                "assessmentResult"
            ],
            safeJSON(result)
        );

        setText(
            [
                "auditOutput",
                "auditResult"
            ],
            safeJSON(
                result.audit ||
                result.auditRecord ||
                result
            )
        );

        /*
         * Decision trace
         */
        setText(
            [
                "decisionEnvironment",
                "traceEnvironment"
            ],
            safeJSON(
                result.environment ||
                {}
            )
        );

        const env =
            result.environment ||
            {};

        setText(
            [
                "traceWind",
                "decisionWind"
            ],
            env.wind !== undefined
                ? env.wind
                : "—"
        );

        setText(
            [
                "traceCurrent",
                "decisionCurrent"
            ],
            env.current !== undefined
                ? env.current
                : "—"
        );

        setText(
            [
                "traceWave",
                "decisionWave"
            ],
            env.wave !== undefined
                ? env.wave
                : "—"
        );

        setText(
            [
                "traceTidal",
                "decisionTidal"
            ],
            env.tidal !== undefined
                ? env.tidal
                : "—"
        );

        /*
         * Primary / secondary / stabilizer
         */
        setText(
            [
                "primaryResponse",
                "decisionPrimaryResponse"
            ],
            result.primaryResponse ||
            result.primaryAction ||
            "—"
        );

        setText(
            [
                "secondaryAssessment",
                "decisionSecondaryAssessment"
            ],
            result.secondaryAssessment ||
            result.secondaryResponse ||
            "—"
        );

        setText(
            [
                "stabilizerSource",
                "decisionStabilizerSource"
            ],
            result.stabilizerSource ||
            result.stabilizer?.source ||
            "—"
        );

        setText(
            [
                "stabilizerOutput",
                "decisionStabilizerOutput"
            ],
            safeJSON(
                result.stabilizerOutput ||
                result.stabilizer ||
                {}
            )
        );

        /*
         * System setup
         */
        if (setup) {
            setText(
                [
                    "tracePositioningMode",
                    "decisionPositioningMode"
                ],
                setup.positioningMode
            );

            setText(
                [
                    "traceEngineLoadMode",
                    "decisionEngineLoadMode"
                ],
                setup.engineLoadMode
            );
        }

        /*
         * Reserve verification
         */
        updateReservePowerDisplay(
            reserveVerification
        );

        /*
         * Recommended action
         */
        updateRecommendedActionDisplay(
            actions,
            result
        );

        /*
         * Captain AI Lena
         */
        updateLenaDisplay(
            actions,
            result
        );

        /*
         * Simulated vessel state
         */
        updateVesselStateDisplay(
            result
        );

        setText(
            [
                "systemStatus",
                "liveSystemStatus"
            ],
            "SIMULATION COMPLETE"
        );

        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            "HUMAN AUTHORIZATION REQUIRED"
        );

        log(
            "ASSESSMENT DISPLAY UPDATED"
        );
    }


    /* ========================================================
       RECOMMENDED ACTION DISPLAY
    ======================================================== */

    function findRecommendedAction(actions) {
        if (!actions) {
            return null;
        }

        if (
            typeof actions === "string"
        ) {
            return actions;
        }

        if (
            actions.recommendedAction
        ) {
            return actions.recommendedAction;
        }

        if (
            actions.action
        ) {
            return actions.action;
        }

        if (
            actions.operationalStatus
        ) {
            return actions.operationalStatus;
        }

        if (
            Array.isArray(actions.actions) &&
            actions.actions.length > 0
        ) {
            const first =
                actions.actions[0];

            if (typeof first === "string") {
                return first;
            }

            return (
                first.recommendation ||
                first.action ||
                null
            );
        }

        return null;
    }


    function updateRecommendedActionDisplay(
        actions,
        result
    ) {
        const action =
            findRecommendedAction(actions);

        const fallback =
            result?.recommendedAction ||
            result?.recommendation ||
            "Maintain the simulated safe state and continue monitoring the assessed conditions.";

        const finalAction =
            action || fallback;

        setText(
            [
                "recommendedAction",
                "liveRecommendedAction",
                "actionRecommendation"
            ],
            finalAction
        );

        setText(
            [
                "actionStatus",
                "recommendedStatus"
            ],
            "DECISION SUPPORT"
        );
    }


    /* ========================================================
       CAPTAIN AI LENA DISPLAY
    ======================================================== */

    function updateLenaDisplay(
        actions,
        result
    ) {
        const recommendation =
            findRecommendedAction(actions) ||
            result?.recommendedAction ||
            result?.recommendation ||
            "Maintain the simulated safe state and continue monitoring the assessed conditions.";

        setText(
            [
                "lenaStatus",
                "captainLenaStatus"
            ],
            "DECISION SUPPORT"
        );

        setText(
            [
                "lenaRecommendation",
                "captainLenaRecommendation"
            ],
            recommendation
        );

        setText(
            [
                "lenaUrgency",
                "captainLenaUrgency"
            ],
            result?.urgency ||
            "NORMAL"
        );

        setText(
            [
                "lenaResponseMode",
                "captainLenaResponseMode"
            ],
            "SIMULATED DP RESPONSE"
        );

        setText(
            [
                "lenaAutonomousCommand",
                "captainLenaAutonomousCommand"
            ],
            "FALSE — NO AUTONOMOUS COMMAND"
        );

        setText(
            [
                "lenaUMVAction",
                "captainLenaUMVAction"
            ],
            "SIMULATION ONLY"
        );

        setText(
            [
                "lenaDecisionSupportMessage",
                "captainLenaMessage"
            ],
            "Captain AI Lena provides decision support only. Human authority remains final. No operational command is generated."
        );
    }


    /* ========================================================
       SIMULATED VESSEL STATE
    ======================================================== */

    function updateVesselStateDisplay(result) {
        const vessel =
            result?.simulatedVesselState ||
            result?.vesselState ||
            {};

        setText(
            [
                "positionError",
                "livePositionError"
            ],
            vessel.positionError !== undefined
                ? Number(
                    vessel.positionError
                ).toFixed(2)
                : "0.00"
        );

        setText(
            [
                "simulatedCommand",
                "liveSimulatedCommand"
            ],
            vessel.simulatedCommand !== undefined
                ? vessel.simulatedCommand
                : result?.simulatedCommand !== undefined
                    ? result.simulatedCommand
                    : "0"
        );

        setText(
            [
                "stabilityIndex",
                "liveStabilityIndex"
            ],
            vessel.stabilityIndex !== undefined
                ? vessel.stabilityIndex
                : result?.stabilityIndex !== undefined
                    ? result.stabilityIndex
                    : "100"
        );

        setText(
            [
                "vesselState",
                "liveVesselState"
            ],
            vessel.state ||
            result?.vesselState?.state ||
            "STABLE"
        );
    }


    /* ========================================================
       HUMAN AUTHORITY
    ======================================================== */

    function setHumanAuthorityStatus(
        message
    ) {
        setText(
            [
                "humanDecisionStatus",
                "humanAuthorityStatus",
                "decisionAuthorityStatus"
            ],
            message
        );

        log(
            "HUMAN AUTHORITY:",
            message
        );
    }


    function acknowledgeCondition() {
        setHumanAuthorityStatus(
            "CONDITION ACKNOWLEDGED — NO ACTION AUTHORIZED"
        );

        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            "HUMAN AUTHORIZATION REQUIRED"
        );

        return {
            acknowledged: true,
            authorized: false,
            executed: false,
            autonomousCommand: false
        };
    }


    function maintainSafeState() {
        setHumanAuthorityStatus(
            "SAFE STATE MAINTAINED — NO SIMULATED ACTION AUTHORIZED"
        );

        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            "SAFE STATE — NO EXECUTION"
        );

        return {
            acknowledged: true,
            safeState: true,
            authorized: false,
            executed: false,
            autonomousCommand: false
        };
    }


    function authorizeSimulatedResponse() {
        const lastResult =
            window.lastDPSimulation;

        if (!lastResult) {
            setHumanAuthorityStatus(
                "NO SIMULATION RESULT — AUTHORIZATION NOT AVAILABLE"
            );

            return {
                authorized: false,
                executed: false,
                autonomousCommand: false
            };
        }

        const setup =
            lastResult.systemSetup ||
            readSystemSetup();

        const reserve =
            extractReserveVerification(
                lastResult
            );

        /*
         * PUSH-UP cannot be authorized through
         * the cockpit unless the authoritative
         * reserve verification is TRUE.
         */
        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !== true
        ) {
            setHumanAuthorityStatus(
                "PUSH-UP BLOCKED — RESERVE NOT VERIFIED"
            );

            setText(
                [
                    "executionStatus",
                    "liveExecutionStatus"
                ],
                "SIMULATION HOLD / RESERVE GATE"
            );

            return {
                authorized: false,
                executed: false,
                blocked: true,
                reason:
                    "RESERVE NOT VERIFIED",
                autonomousCommand: false
            };
        }

        /*
         * Human authorization applies ONLY to the
         * simulated V&V response.
         *
         * It NEVER enables real operational execution.
         */
        setHumanAuthorityStatus(
            "SIMULATED RESPONSE AUTHORIZED FOR V&V REVIEW — NO REAL COMMAND"
        );

        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            "SIMULATED RESPONSE AUTHORIZED — NO REAL EXECUTION"
        );

        return {
            authorized: true,
            simulatedOnly: true,
            executed: false,
            realVesselConnection: false,
            autonomousCommand: false,
            humanAuthority: "FINAL"
        };
    }


    /* ========================================================
       HUMAN AUTHORITY COMPATIBILITY ALIASES
       ======================================================== */

    window.acknowledgeCondition =
        acknowledgeCondition;

    window.maintainSafeState =
        maintainSafeState;

    window.authorizeSimulatedResponse =
        authorizeSimulatedResponse;


    /* ========================================================
       SIMULATED DP RESPONSE
       ======================================================== */

    function simulatedDPResponse(
        result,
        humanDecision
    ) {
        const setup =
            result?.systemSetup ||
            readSystemSetup();

        const reserve =
            extractReserveVerification(
                result
            );

        let response;

        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP
        ) {
            if (
                reserve.reserveVerified === true
            ) {
                response =
                    "PUSH-UP SIMULATION PERMITTED FOR HUMAN REVIEW";
            } else {
                response =
                    "PUSH-UP BLOCKED — RESERVE NOT VERIFIED";
            }
        } else {
            response =
                "NORMAL LOAD — HUMAN REVIEW REQUIRED";
        }

        const output = {
            executed: false,

            humanAuthorizationRequired:
                true,

            humanDecision:
                humanDecision || null,

            realVesselConnection:
                false,

            autonomousCommand:
                false,

            simulatedOnly:
                true,

            response
        };

        setText(
            [
                "responseMode",
                "simulatedResponseMode"
            ],
            "SIMULATED DP RESPONSE"
        );

        setText(
            [
                "proposedAction",
                "simulatedProposedAction"
            ],
            response
        );

        setText(
            [
                "gate",
                "executionGate"
            ],
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !== true
                ? "BLOCKED — RESERVE NOT VERIFIED"
                : "HUMAN AUTHORIZATION REQUIRED"
        );

        setText(
            [
                "actionStatus",
                "simulatedActionStatus"
            ],
            "SIMULATION ONLY — NO REAL EXECUTION"
        );

        return output;
    }


    /* ========================================================
       HUMAN GATE
    ======================================================== */

    function applyHumanAuthority(
        result,
        reserveVerification
    ) {
        const setup =
            result?.systemSetup ||
            readSystemSetup();

        const reserve =
            reserveVerification ||
            extractReserveVerification(result);

        const gate = {
            humanAuthorizationRequired: true,
            humanAuthority: HUMAN_AUTHORITY,
            autonomousCommand: false,
            realVesselConnection: false,
            executed: false
        };

        /*
         * Explicit PUSH-UP safety gate.
         */
        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !== true
        ) {
            gate.authorized = false;
            gate.blocked = true;
            gate.reason =
                "RESERVE NOT VERIFIED";

            setText(
                [
                    "humanDecisionStatus",
                    "humanAuthorityStatus"
                ],
                "PUSH-UP BLOCKED — RESERVE NOT VERIFIED"
            );

            setText(
                [
                    "gate",
                    "executionGate"
                ],
                "BLOCKED — RESERVE NOT VERIFIED"
            );

            return gate;
        }

        gate.authorized = false;

        setText(
            [
                "gate",
                "executionGate"
            ],
            "HUMAN AUTHORIZATION REQUIRED"
        );

        return gate;
    }


    /* ========================================================
       MAIN PIPELINE
    ======================================================== */

    function runPipeline() {
        try {
            log(
                "================================================"
            );

            log(
                "STARTING DP V&V SIMULATION"
            );

            log(
                "MODULE:",
                MODULE_NAME
            );

            log(
                "VERSION:",
                VERSION
            );

            displaySafety();

            const setup =
                updateSystemSetupDisplay(
                    readSystemSetup()
                );

            const environment =
                readEnvironment();

            updateEnvironmentDisplay(
                environment
            );

            setText(
                [
                    "engineStatus",
                    "liveEngineStatus"
                ],
                "CONNECTED — RUNNING"
            );

            setText(
                [
                    "environmentStatus",
                    "liveEnvironmentStatus"
                ],
                "PROCESSING"
            );

            /*
             * AUTHORITATIVE ENGINE
             */
            const result =
                executeEngine(
                    environment
                );

            /*
             * Preserve system setup explicitly.
             */
            if (
                !result.systemSetup
            ) {
                result.systemSetup = {
                    positioningMode:
                        setup.positioningMode,

                    engineLoadMode:
                        setup.engineLoadMode
                };
            }

            /*
             * RECOMMENDED ACTIONS
             */
            const actions =
                executeRecommendedActions(
                    result
                );

            /*
             * RESERVE VERIFICATION
             */
            const reserveVerification =
                extractReserveVerification(
                    result
                );

            /*
             * HUMAN GATE
             */
            const humanGate =
                applyHumanAuthority(
                    result,
                    reserveVerification
                );

            /*
             * SIMULATED RESPONSE
             */
            const simulatedResponse =
                simulatedDPResponse(
                    result,
                    humanGate
                );

            /*
             * Attach controller-level gate data
             * without changing authoritative engine
             * calculations.
             */
            result.humanAuthorityGate =
                humanGate;

            result.simulatedDPResponse =
                simulatedResponse;

            result.recommendedActions =
                actions;

            /*
             * Audit controller event.
             */
            result.cockpitAudit = {
                module: MODULE_NAME,
                version: VERSION,
                timestamp:
                    new Date().toISOString(),

                systemSetup: setup,

                reservePowerVerification:
                    reserveVerification,

                humanAuthority:
                    HUMAN_AUTHORITY,

                autonomousCommand:
                    false,

                realVesselConnection:
                    false,

                simulatedOnly:
                    true
            };

            /*
             * Update all screen sections.
             */
            updateAssessment(
                result,
                actions,
                reserveVerification,
                setup
            );

            setText(
                [
                    "engineStatus",
                    "liveEngineStatus"
                ],
                "CONNECTED — READY"
            );

            setText(
                [
                    "environmentStatus",
                    "liveEnvironmentStatus"
                ],
                "INPUTS PROCESSED"
            );

            setText(
                [
                    "primaryAIStatus",
                    "livePrimaryAI"
                ],
                "NORMAL CONTROL"
            );

            setText(
                [
                    "secondaryAIStatus",
                    "liveSecondaryAI"
                ],
                "INDEPENDENT MONITORING"
            );

            setText(
                [
                    "stabilizerStatus",
                    "liveStabilizer"
                ],
                "STABLE"
            );

            setText(
                [
                    "humanAuthorityStatus",
                    "liveHumanAuthority"
                ],
                "HUMAN AUTHORIZATION REQUIRED"
            );

            setText(
                [
                    "systemStatus",
                    "liveSystemStatus"
                ],
                "SIMULATION COMPLETE"
            );

            setText(
                [
                    "executionStatus",
                    "liveExecutionStatus"
                ],
                "HUMAN AUTHORIZATION REQUIRED"
            );

            /*
             * Global research/debug references.
             */
            window.lastDPSimulation =
                result;

            window.lastDPRecommendedActions =
                actions;

            log(
                "SIMULATION COMPLETE"
            );

            log(
                "HUMAN AUTHORITY REMAINS FINAL"
            );

            log(
                "NO AUTONOMOUS OPERATIONAL EXECUTION"
            );

            log(
                "================================================"
            );

            return result;

        } catch (error) {
            console.error(
                "[Sextant DP Cockpit] SIMULATION ERROR:",
                error
            );

            setText(
                [
                    "systemStatus",
                    "liveSystemStatus"
                ],
                "SIMULATION ERROR"
            );

            setText(
                [
                    "executionStatus",
                    "liveExecutionStatus"
                ],
                "HUMAN AUTHORIZATION REQUIRED"
            );

            setText(
                [
                    "assessmentOutput",
                    "assessmentResult"
                ],
                "SIMULATION ERROR\n\n" +
                error.message
            );

            setText(
                [
                    "auditOutput",
                    "auditResult"
                ],
                safeJSON({
                    module: MODULE_NAME,
                    version: VERSION,
                    error: error.message,
                    timestamp:
                        new Date().toISOString()
                })
            );

            return null;
        }
    }


