/*
============================================================
SEXTANT PROTOCOL™
DP RESILIENCE V&V RESEARCH COCKPIT
============================================================

FILE:
dp_cockpit.js

VERSION:
2.6.0

PURPOSE:
Browser-side controller for the deterministic DP resilience
research / V&V cockpit.

ARCHITECTURE:

ENVIRONMENT
    ↓
SYSTEM SETUP
    ↓
PRIMARY AI
    ↓
SECONDARY AI
    ↓
STABILIZER
    ↓
RECOMMENDED ACTIONS ENGINE
    ↓
RESERVE-POWER VERIFICATION
    ↓
HUMAN-IN-THE-LOOP
    ↓
SIMULATED DP RESPONSE
    ↓
UPDATED SIMULATED STATE
    ↓
AUDIT

SAFETY BOUNDARY:
SIMULATION ONLY — NO AUTONOMOUS OPERATIONAL COMMAND

CRITICAL DISTINCTION:
BIAS     = POSITIONING MODE ONLY
PUSH-UP  = ENGINE LOAD COMPENSATION ONLY
PUSH-UP ≠ POSITIONING BIAS

PUSH-UP SAFETY:
PUSH-UP REQUIRES AUTHORITATIVE RESERVE-POWER
VERIFICATION.

UNKNOWN / UNVERIFIED RESERVE:
NOT SUFFICIENT FOR PUSH-UP.

HUMAN AUTHORITY:
FINAL

REAL VESSEL:
NO

AUTONOMOUS COMMAND:
NO

CERTIFICATION:
NOT CERTIFIED

IMPORTANT CONTROLLER RULE:
The simulation engine is authoritative for:
- environmental assessment
- risk
- reserve verification
- proposed response
- human decision state
- final simulated response
- audit

This controller is an interface layer only.

============================================================
*/

(function () {

    "use strict";


    /* ========================================================
       MODULE CONSTANTS
    ======================================================== */

    const MODULE_NAME =
        "SextantDPResilienceCockpit";

    const VERSION =
        "2.6.0";

    const SIMULATION_ENGINE_VERSION =
        "1.2.0";

    const RECOMMENDED_ACTIONS_VERSION =
        "SPD-DP-RECOMMENDED-ACTIONS-V1.2";

    const SAFETY_BOUNDARY =
        "SIMULATION ONLY — NO AUTONOMOUS OPERATIONAL COMMAND";

    const AUTONOMOUS_COMMAND =
        false;

    const REAL_VESSEL_CONNECTION =
        false;

    const HUMAN_AUTHORITY =
        "FINAL";


    /* ========================================================
       SYSTEM SETUP MODES
    ======================================================== */

    const POSITIONING_MODES = {

        NON_BIAS:
            "NON_BIAS",

        BIAS:
            "BIAS"

    };


    const ENGINE_LOAD_MODES = {

        NORMAL:
            "NORMAL",

        PUSH_UP:
            "PUSH_UP"

    };


    /* ========================================================
       PIPELINE
    ======================================================== */

    const PIPELINE = [

        "ENVIRONMENT",

        "SYSTEM SETUP",

        "S1 PRIMARY AI",

        "S2 SECONDARY AI",

        "STABILIZER",

        "RECOMMENDED ACTIONS ENGINE",

        "RESERVE-POWER VERIFICATION",

        "HUMAN-IN-THE-LOOP",

        "SIMULATED DP RESPONSE",

        "UPDATED SIMULATED STATE",

        "AUDIT"

    ];


    /* ========================================================
       BASIC DOM HELPERS
    ======================================================== */

    function byId(id) {

        return document.getElementById(id);

    }


    function firstById(ids) {

        for (
            let i = 0;
            i < ids.length;
            i++
        ) {

            const el =
                byId(ids[i]);

            if (el) {

                return el;

            }

        }

        return null;

    }


    function setText(ids, value) {

        const el =
            firstById(
                Array.isArray(ids)
                    ? ids
                    : [ids]
            );

        if (el) {

            el.textContent =
                value === undefined ||
                value === null
                    ? ""
                    : String(value);

        }

    }


    function setValue(ids, value) {

        const el =
            firstById(
                Array.isArray(ids)
                    ? ids
                    : [ids]
            );

        if (!el) {

            return false;

        }

        el.value =
            value;

        return true;

    }


    function getValue(ids, fallback) {

        const el =
            firstById(
                Array.isArray(ids)
                    ? ids
                    : [ids]
            );

        if (!el) {

            return fallback;

        }

        return el.value;

    }


    function parseNumber(ids, fallback) {

        const value =
            Number(
                getValue(
                    ids,
                    fallback
                )
            );

        return Number.isFinite(value)
            ? value
            : fallback;

    }


    function safeJSON(value) {

        try {

            return JSON.stringify(
                value,
                null,
                2
            );

        } catch (error) {

            return String(value);

        }

    }


    function log(message, data) {

        if (
            data !== undefined
        ) {

            console.log(
                "[Sextant DP Cockpit]",
                message,
                data
            );

        } else {

            console.log(
                "[Sextant DP Cockpit]",
                message
            );

        }

    }


    /* ========================================================
       SAFETY DISPLAY
    ======================================================== */

    function displaySafety() {

        setText(
            [
                "safetyBoundary",
                "liveSafetyBoundary",
                "safetyStatus"
            ],
            SAFETY_BOUNDARY
        );

        setText(
            [
                "autonomousCommand",
                "liveAutonomousCommand"
            ],
            "FALSE — NO AUTONOMOUS COMMAND"
        );

        setText(
            [
                "humanAuthority",
                "liveHumanAuthority"
            ],
            "FINAL"
        );

    }


    /* ========================================================
       ENGINE DISCOVERY
    ======================================================== */

    function discoverSimulationEngine() {

        const candidates = [

            "DPSimulationEngine",

            "DPSimulatorEngine",

            "DPResilienceEngine",

            "dpSimulationEngine",

            "dpEngine"

        ];


        for (
            let i = 0;
            i < candidates.length;
            i++
        ) {

            const candidate =
                window[candidates[i]];

            if (
                candidate &&
                typeof candidate.run ===
                    "function"
            ) {

                return candidate;

            }

        }

        return null;

    }


    /* ========================================================
       RECOMMENDED ACTIONS ENGINE
    ======================================================== */

    function discoverRecommendedActionsEngine() {

        if (
            window.DPRecommendedActions &&
            typeof
                window.DPRecommendedActions.generate ===
                    "function"
        ) {

            return window.DPRecommendedActions;

        }

        return null;

    }


    function retryRecommendedActionsEngine() {

        const engine =
            discoverRecommendedActionsEngine();

        if (engine) {

            log(
                "RECOMMENDED ACTIONS ENGINE CONNECTED",
                engine.version ||
                RECOMMENDED_ACTIONS_VERSION
            );

        } else {

            log(
                "RECOMMENDED ACTIONS ENGINE NOT DETECTED"
            );

        }

        return engine;

    }


    /* ========================================================
       SYSTEM SETUP
    ======================================================== */

    function readSystemSetup() {

        let positioningMode =
            getValue(
                [
                    "positioningMode",
                    "positionMode",
                    "biasMode"
                ],
                POSITIONING_MODES.NON_BIAS
            );


        let engineLoadMode =
            getValue(
                [
                    "engineLoadMode",
                    "loadMode",
                    "engineMode"
                ],
                ENGINE_LOAD_MODES.NORMAL
            );


        if (
            positioningMode !==
                POSITIONING_MODES.BIAS &&
            positioningMode !==
                POSITIONING_MODES.NON_BIAS
        ) {

            positioningMode =
                POSITIONING_MODES.NON_BIAS;

        }


        if (
            engineLoadMode !==
                ENGINE_LOAD_MODES.PUSH_UP &&
            engineLoadMode !==
                ENGINE_LOAD_MODES.NORMAL
        ) {

            engineLoadMode =
                ENGINE_LOAD_MODES.NORMAL;

        }


        return {

            positioningMode:
                positioningMode,

            engineLoadMode:
                engineLoadMode

        };

    }


    function updateSystemSetupDisplay(setup) {

        const current =
            setup ||
            readSystemSetup();


        const positioningLabel =
            current.positioningMode ===
                POSITIONING_MODES.BIAS

                ? "BIAS — POSITIONING MODE"

                : "NON-BIAS — STANDARD POSITIONING";


        const loadLabel =
            current.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP

                ? "PUSH-UP — ENGINE LOAD COMPENSATION"

                : "NORMAL — NOMINAL ENGINE LOAD";


        setText(
            "livePositioningMode",
            current.positioningMode
        );


        setText(
            "liveEngineLoadMode",
            current.engineLoadMode
        );


        setText(
            [
                "positioningModeStatus",
                "positioningStatus"
            ],
            positioningLabel
        );


        setText(
            [
                "engineLoadModeStatus",
                "engineLoadStatus"
            ],
            loadLabel
        );


        setText(
            [
                "setupDistinction",
                "modeDistinction"
            ],
            "POSITIONING BIAS/NON-BIAS IS SEPARATE FROM ENGINE LOAD NORMAL/PUSH-UP"
        );


        log(
            "POSITIONING MODE:",
            current.positioningMode
        );


        log(
            "ENGINE LOAD MODE:",
            current.engineLoadMode
        );


        log(
            "PUSH-UP ≠ POSITIONING BIAS"
        );


        return current;

    }


    /* ========================================================
       ENVIRONMENT
    ======================================================== */

    function readEnvironment() {

        const setup =
            readSystemSetup();


        return {

            wind:
                parseNumber(
                    [
                        "wind",
                        "windSpeed",
                        "windForce"
                    ],
                    0
                ),

            current:
                parseNumber(
                    [
                        "current",
                        "currentSpeed",
                        "currentForce"
                    ],
                    0
                ),

            wave:
                parseNumber(
                    [
                        "wave",
                        "waveHeight",
                        "waveForce"
                    ],
                    0
                ),

            tidal:
                parseNumber(
                    [
                        "tidal",
                        "tide",
                        "tidalForce"
                    ],
                    0
                ),

            positioningMode:
                setup.positioningMode,

            engineLoadMode:
                setup.engineLoadMode

        };

    }


    /* ========================================================
       ENVIRONMENT DISPLAY
    ======================================================== */

    function updateEnvironmentDisplay(
        environment
    ) {

        if (!environment) {

            return;

        }


        setText(
            [
                "liveWind",
                "displayWind"
            ],
            environment.wind
        );


        setText(
            [
                "liveCurrent",
                "displayCurrent"
            ],
            environment.current
        );


        setText(
            [
                "liveWave",
                "displayWave"
            ],
            environment.wave
        );


        setText(
            [
                "liveTidal",
                "displayTidal"
            ],
            environment.tidal
        );


        setText(
            [
                "environmentStatus",
                "liveEnvironmentStatus"
            ],
            "INPUTS RECEIVED"
        );

    }


    /* ========================================================
       AUTHORITATIVE ENGINE EXECUTION
    ======================================================== */

    function executeEngine(environment) {

        const engine =
            discoverSimulationEngine();


        if (!engine) {

            throw new Error(
                "DP Simulation Engine is not connected."
            );

        }


        if (
            typeof engine.run !==
                "function"
        ) {

            throw new Error(
                "DP Simulation Engine does not expose run()."
            );

        }


        log(
            "EXECUTING AUTHORITATIVE DP SIMULATION ENGINE"
        );


        const result =
            engine.run(
                environment
            );


        if (!result) {

            throw new Error(
                "DP Simulation Engine returned no result."
            );

        }


        return result;

    }


    /* ========================================================
       AUTHORITATIVE HUMAN ENGINE ACCESS
    ======================================================== */

    function discoverHumanEngineMethod(
        methodName
    ) {

        const engine =
            discoverSimulationEngine();


        if (
            !engine
        ) {

            return null;

        }


        if (
            typeof engine[methodName] ===
                "function"
        ) {

            return engine[methodName]
                .bind(engine);

        }


        return null;

    }


    /* ========================================================
       RECOMMENDED ACTIONS
    ======================================================== */

    function executeRecommendedActions(
        result
    ) {

        if (!result) {

            return null;

        }


        /*
         * The authoritative engine already returns
         * result.recommendedAction.
         *
         * That object is preferred over any controller
         * generated replacement.
         */

        if (
            result.recommendedAction
        ) {

            return result.recommendedAction;

        }


        if (
            result.recommendedActions
        ) {

            return result.recommendedActions;

        }


        if (
            result.recommendations
        ) {

            return result.recommendations;

        }


        const actions =
            discoverRecommendedActionsEngine();


        if (
            actions &&
            typeof actions.generate ===
                "function"
        ) {

            return actions.generate(
                result
            );

        }


        return null;

    }


    /* ========================================================
       RESERVE-POWER VERIFICATION
    ======================================================== */

    function extractReserveVerification(
        result
    ) {

        if (!result) {

            return {

                reserveVerified:
                    false,

                availableReserve:
                    null,

                requiredReserve:
                    null,

                status:
                    "NOT VERIFIED",

                verificationSource:
                    "NO SIMULATION RESULT"

            };

        }


        const reserve =
            result.reservePowerVerification ||
            result.reserveVerification ||
            null;


        if (!reserve) {

            return {

                reserveVerified:
                    false,

                availableReserve:
                    null,

                requiredReserve:
                    null,

                status:
                    "NOT VERIFIED",

                verificationSource:
                    "NO AUTHORITATIVE RESERVE RESULT"

            };

        }


        return {

            reserveVerified:
                reserve.reserveVerified ===
                    true,

            availableReserve:
                reserve.availableReserve !==
                    undefined

                    ? reserve.availableReserve

                    : null,

            requiredReserve:
                reserve.requiredReserve !==
                    undefined

                    ? reserve.requiredReserve

                    : null,

            status:
                reserve.status ||
                (
                    reserve.reserveVerified ===
                        true

                        ? "VERIFIED"

                        : "NOT VERIFIED"
                ),

            verificationSource:
                reserve.verificationSource ||
                "AUTHORITATIVE DP SIMULATION ENGINE"

        };

    }


    function updateReservePowerDisplay(
        reserveVerification
    ) {

        const reserve =
            reserveVerification || {

                reserveVerified:
                    false,

                availableReserve:
                    null,

                requiredReserve:
                    null,

                status:
                    "NOT VERIFIED"

            };


        const verified =
            reserve.reserveVerified ===
                true;


        const available =
            reserve.availableReserve;


        const required =
            reserve.requiredReserve;


        /*
         * IMPORTANT:
         *
         * This display is always derived from the
         * authoritative engine result.
         *
         * No controller-side "verified" default.
         */

        setText(
            [
                "liveReserve",
                "reserveVerification"
            ],
            verified
                ? "VERIFIED"
                : "NOT VERIFIED"
        );


        setText(
            "reserveStatus",
            reserve.status ||
            (
                verified
                    ? "VERIFIED"
                    : "NOT VERIFIED"
            )
        );


        setText(
            [
                "availableReserve",
                "reserveAvailable"
            ],
            available === null ||
            available === undefined

                ? "—"

                : Number(
                    available
                ).toFixed(2)
        );


        setText(
            [
                "requiredReserve",
                "reserveRequired"
            ],
            required === null ||
            required === undefined

                ? "—"

                : Number(
                    required
                ).toFixed(2)
        );


        setText(
            [
                "reserveGate",
                "reservePowerGate"
            ],
            verified
                ? "RESERVE VERIFIED"
                : "NOT VERIFIED"
        );


        log(
            "AUTHORITATIVE RESERVE VERIFICATION:",
            reserve
        );

    }


    /* ========================================================
       RESULT FIELD HELPERS
    ======================================================== */

    function getPrimary(result) {

        return result?.primary || {};

    }


    function getSecondary(result) {

        return result?.secondary || {};

    }


    function getStabilizer(result) {

        return result?.stabilizer || {};

    }


    /* ========================================================
       ASSESSMENT DISPLAY
    ======================================================== */

    function updateAssessment(
        result,
        actions,
        reserveVerification,
        setup
    ) {

        if (!result) {

            return;

        }


        const primary =
            getPrimary(result);


        const secondary =
            getSecondary(result);


        const stabilizer =
            getStabilizer(result);


        const risk =
            result.risk ||
            result.assessment?.risk ||
            result.assessment?.riskLevel ||
            "—";


        /*
         * Risk
         */

        setText(
            [
                "riskLevel",
                "assessmentRisk",
                "risk"
            ],
            risk
        );


        /*
         * Primary
         */

        setText(
            [
                "primaryMode",
                "assessmentPrimaryMode"
            ],
            primary.mode ||
            result.primaryState ||
            result.primaryMode ||
            "—"
        );


        setText(
            [
                "primaryResponse",
                "decisionPrimaryResponse"
            ],
            primary.response ||
            result.primaryResponse ||
            result.primaryAction ||
            "—"
        );


        /*
         * Secondary
         */

        setText(
            [
                "secondaryMode",
                "assessmentSecondaryMode"
            ],
            secondary.mode ||
            result.secondaryState ||
            result.secondaryMode ||
            "—"
        );


        setText(
            [
                "secondaryAssessment",
                "decisionSecondaryAssessment"
            ],
            secondary.assessment ||
            result.secondaryAssessment ||
            result.secondaryResponse ||
            "—"
        );


        /*
         * Stabilizer
         */

        setText(
            [
                "stabilizerMode",
                "assessmentStabilizerMode"
            ],
            stabilizer.mode ||
            result.stabilizerMode ||
            "—"
        );


        setText(
            [
                "stabilizerSource",
                "decisionStabilizerSource"
            ],
            stabilizer.source ||
            result.stabilizerSource ||
            "—"
        );


        setText(
            [
                "stabilizerOutput",
                "decisionStabilizerOutput"
            ],
            safeJSON(
                stabilizer
            )
        );


        /*
         * Environment
         */

        const environment =
            result.environment ||
            {};


        setText(
            [
                "decisionEnvironment",
                "traceEnvironment"
            ],
            safeJSON(
                environment
            )
        );


        setText(
            [
                "traceWind",
                "decisionWind"
            ],
            environment.wind !==
                undefined

                ? environment.wind

                : "—"
        );


        setText(
            [
                "traceCurrent",
                "decisionCurrent"
            ],
            environment.current !==
                undefined

                ? environment.current

                : "—"
        );


        setText(
            [
                "traceWave",
                "decisionWave"
            ],
            environment.wave !==
                undefined

                ? environment.wave

                : "—"
        );


        setText(
            [
                "traceTidal",
                "decisionTidal"
            ],
            environment.tidal !==
                undefined

                ? environment.tidal

                : "—"
        );


        /*
         * System setup
         */

        const authoritativeSetup =
            result.systemSetup ||
            setup ||
            readSystemSetup();


        setText(
            [
                "tracePositioningMode",
                "decisionPositioningMode"
            ],
            authoritativeSetup.positioningMode
        );


        setText(
            [
                "traceEngineLoadMode",
                "decisionEngineLoadMode"
            ],
            authoritativeSetup.engineLoadMode
        );


        /*
         * Reserve verification
         */

        updateReservePowerDisplay(
            reserveVerification
        );


        /*
         * Recommended actions
         */

        updateRecommendedActionDisplay(
            actions,
            result
        );


        /*
         * Captain AI Lena
         */

        updateLenaDisplay(
            actions,
            result
        );


        /*
         * Simulated vessel state
         */

        updateVesselStateDisplay(
            result
        );


        /*
         * Full assessment result
         */

        setText(
            [
                "assessmentOutput",
                "assessmentResult"
            ],
            safeJSON(
                result
            )
        );


        /*
         * Full authoritative audit
         */

        setText(
            [
                "auditOutput",
                "auditResult"
            ],
            safeJSON(
                result.audit ||
                result.auditRecord ||
                result.cockpitAudit ||
                result
            )
        );


        log(
            "ASSESSMENT DISPLAY UPDATED"
        );

    }


    /* ========================================================
       RECOMMENDED ACTION DISPLAY
    ======================================================== */

    function findRecommendedAction(
        actions
    ) {

        if (!actions) {

            return null;

        }


        if (
            typeof actions ===
                "string"
        ) {

            return actions;

        }


        if (
            actions.primaryRecommendation
        ) {

            return actions.primaryRecommendation;

        }


        if (
            actions.recommendedAction
        ) {

            return actions.recommendedAction;

        }


        if (
            actions.action
        ) {

            return actions.action;

        }


        if (
            actions.operationalStatus
        ) {

            return actions.operationalStatus;

        }


        if (
            Array.isArray(
                actions.actions
            ) &&
            actions.actions.length > 0
        ) {

            const first =
                actions.actions[0];


            if (
                typeof first ===
                    "string"
            ) {

                return first;

            }


            return (
                first.recommendation ||
                first.action ||
                null
            );

        }


        return null;

    }


    function updateRecommendedActionDisplay(
        actions,
        result
    ) {

        const action =
            findRecommendedAction(
                actions
            );


        const resultRecommendation =
            result?.recommendedAction;


        const fallback =
            resultRecommendation?.primaryRecommendation ||
            result?.recommendation ||
            "Maintain the simulated safe state and continue monitoring the assessed conditions.";


        const finalAction =
            action ||
            fallback;


        setText(
            [
                "recommendedAction",
                "liveRecommendedAction",
                "actionRecommendation"
            ],
            finalAction
        );


        setText(
            [
                "actionStatus",
                "recommendedStatus"
            ],
            "DECISION SUPPORT"
        );

    }


    /* ========================================================
       CAPTAIN AI LENA DISPLAY
    ======================================================== */

    function updateLenaDisplay(
        actions,
        result
    ) {

        const resultRecommendation =
            result?.recommendedAction;


        const recommendation =
            findRecommendedAction(
                actions
            ) ||
            resultRecommendation?.primaryRecommendation ||
            result?.recommendation ||
            "Maintain the simulated safe state and continue monitoring the assessed conditions.";


        setText(
            [
                "lenaStatus",
                "captainLenaStatus"
            ],
            "DECISION SUPPORT"
        );


        setText(
            [
                "lenaRecommendation",
                "captainLenaRecommendation"
            ],
            recommendation
        );


        setText(
            [
                "lenaUrgency",
                "captainLenaUrgency"
            ],
            resultRecommendation?.urgency ||
            result?.urgency ||
            "NORMAL"
        );


        setText(
            [
                "lenaResponseMode",
                "captainLenaResponseMode"
            ],
            resultRecommendation?.responseMode ||
            "SIMULATED DP RESPONSE"
        );


        setText(
            [
                "lenaAutonomousCommand",
                "captainLenaAutonomousCommand"
            ],
            "FALSE — NO AUTONOMOUS COMMAND"
        );


        setText(
            [
                "lenaUMVAction",
                "captainLenaUMVAction"
            ],
            "SIMULATION ONLY"
        );


        setText(
            [
                "lenaDecisionSupportMessage",
                "captainLenaMessage"
            ],
            "Captain AI Lena provides decision support only. Human authority remains final. No operational command is generated."
        );

    }


    /* ========================================================
       SIMULATED VESSEL STATE
       ======================================================== */

    function updateVesselStateDisplay(
        result
    ) {

        /*
         * dp_simulation_engine.js v1.2.0 calls
         * this object "updatedState".
         *
         * Previous controller versions did not read it.
         */

        const vessel =
            result?.updatedState ||
            result?.simulatedVesselState ||
            result?.vesselState ||
            {};


        setText(
            [
                "positionError",
                "livePositionError"
            ],
            vessel.positionError !==
                undefined

                ? Number(
                    vessel.positionError
                ).toFixed(2)

                : "0.00"
        );


        setText(
            [
                "simulatedCommand",
                "liveSimulatedCommand"
            ],
            vessel.simulatedCommand !==
                undefined

                ? vessel.simulatedCommand

                : result?.simulatedAction
                    ?.simulatedCommand !==
                    undefined

                    ? result.simulatedAction
                        .simulatedCommand

                    : "0"
        );


        setText(
            [
                "stabilityIndex",
                "liveStabilityIndex"
            ],
            vessel.stabilityIndex !==
                undefined

                ? Number(
                    vessel.stabilityIndex
                ).toFixed(2)

                : "100"
        );


        setText(
            [
                "vesselState",
                "liveVesselState"
            ],
            vessel.state ||
            vessel.status ||
            result?.simulatedAction?.status ||
            "STABLE"
        );

    }


    /* ========================================================
       HUMAN AUTHORITY DISPLAY
    ======================================================== */

    function updateHumanAuthorityDisplay(
        result
    ) {

        const human =
            result?.human ||
            {};


        const gate =
            result?.executionGate ||
            result?.humanAuthorityGate ||
            {};


        let message =
            "HUMAN AUTHORIZATION REQUIRED";


        if (
            human.decision ===
                "MAINTAIN_SAFE_STATE"
        ) {

            message =
                "SAFE STATE MAINTAINED — SIMULATED";

        } else if (
            human.decision ===
                "AUTHORIZE_SIMULATED_RESPONSE"
        ) {

            message =
                "SIMULATED RESPONSE AUTHORIZED — NO REAL COMMAND";

        } else if (
            human.decision ===
                "ACKNOWLEDGED"
        ) {

            message =
                "CONDITION ACKNOWLEDGED — HUMAN DECISION PENDING";

        } else if (
            gate.blocked
        ) {

            message =
                "PUSH-UP BLOCKED — RESERVE NOT VERIFIED";

        }


        setText(
            [
                "humanDecisionStatus",
                "humanAuthorityStatus"
            ],
            message
        );


        if (
            gate.status
        ) {

            setText(
                [
                    "gate",
                    "executionGate"
                ],
                gate.status
            );

        }


        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            result?.simulatedAction
                ?.status ||
            gate.status ||
            "HUMAN AUTHORIZATION REQUIRED"
        );

    }


    /* ========================================================
       HUMAN DECISION — AUTHORITATIVE ENGINE
    ======================================================== */

    function acknowledgeCondition(
        reason
    ) {

        const acknowledge =
            discoverHumanEngineMethod(
                "acknowledgeHumanDecision"
            );


        if (!acknowledge) {

            setHumanAuthorityStatus(
                "ENGINE HUMAN-DECISION API NOT AVAILABLE"
            );

            return {

                acknowledged:
                    false,

                authorized:
                    false,

                executed:
                    false,

                autonomousCommand:
                    false

            };

        }


        const result =
            acknowledge(
                reason ||
                "Human operator acknowledged the simulated condition."
            );


        if (
            result &&
            result.success === false
        ) {

            setHumanAuthorityStatus(
                result.message ||
                "NO PENDING SIMULATION"
            );

            return result;

        }


        window.lastDPSimulation =
            result;


        /*
         * The engine returns the authoritative
         * pending simulation after acknowledgement.
         */

        updateAssessment(
            result,
            executeRecommendedActions(result),
            extractReserveVerification(result),
            result.systemSetup
        );


        updateHumanAuthorityDisplay(
            result
        );


        log(
            "HUMAN ACKNOWLEDGEMENT ACCEPTED BY AUTHORITATIVE ENGINE"
        );


        return result;

    }


    function maintainSafeState(
        reason
    ) {

        const maintain =
            discoverHumanEngineMethod(
                "maintainSafeState"
            );


        if (!maintain) {

            setHumanAuthorityStatus(
                "ENGINE HUMAN-DECISION API NOT AVAILABLE"
            );

            return {

                acknowledged:
                    false,

                authorized:
                    false,

                executed:
                    false,

                autonomousCommand:
                    false

            };

        }


        const result =
            maintain(
                reason ||
                "Human operator elected to maintain the simulated safe state."
            );


        if (
            result &&
            result.success === false
        ) {

            setHumanAuthorityStatus(
                result.message ||
                "NO PENDING SIMULATION"
            );

            return result;

        }


        window.lastDPSimulation =
            result;


        updateAssessment(
            result,
            executeRecommendedActions(result),
            extractReserveVerification(result),
            result.systemSetup
        );


        updateHumanAuthorityDisplay(
            result
        );


        log(
            "HUMAN DECISION: MAINTAIN SAFE STATE"
        );


        return result;

    }


    function authorizeSimulatedResponse(
        reason
    ) {

        const current =
            window.lastDPSimulation;


        if (!current) {

            setHumanAuthorityStatus(
                "NO SIMULATION RESULT — AUTHORIZATION NOT AVAILABLE"
            );

            return {

                authorized:
                    false,

                executed:
                    false,

                autonomousCommand:
                    false

            };

        }


        const setup =
            current.systemSetup ||
            readSystemSetup();


        const reserve =
            extractReserveVerification(
                current
            );


        /*
         * Controller-side pre-gate.
         *
         * The authoritative engine has the final gate.
         */

        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !==
                true
        ) {

            setHumanAuthorityStatus(
                "PUSH-UP BLOCKED — RESERVE NOT VERIFIED"
            );


            setText(
                [
                    "executionStatus",
                    "liveExecutionStatus"
                ],
                "SIMULATION HOLD / RESERVE GATE"
            );


            return {

                authorized:
                    false,

                executed:
                    false,

                blocked:
                    true,

                reason:
                    "RESERVE NOT VERIFIED",

                autonomousCommand:
                    false

            };

        }


        /*
         * Human acknowledgement must occur first.
         *
         * The authoritative engine enforces this.
         */

        if (
            current.human &&
            current.human.acknowledged !==
                true
        ) {

            setHumanAuthorityStatus(
                "HUMAN ACKNOWLEDGEMENT REQUIRED BEFORE AUTHORIZATION"
            );


            return {

                authorized:
                    false,

                executed:
                    false,

                blocked:
                    true,

                reason:
                    "HUMAN ACKNOWLEDGEMENT REQUIRED",

                autonomousCommand:
                    false

            };

        }


        const authorize =
            discoverHumanEngineMethod(
                "authorizeSimulatedResponse"
            );


        if (!authorize) {

            setHumanAuthorityStatus(
                "ENGINE HUMAN-AUTHORIZATION API NOT AVAILABLE"
            );

            return {

                authorized:
                    false,

                executed:
                    false,

                autonomousCommand:
                    false

            };

        }


        const result =
            authorize(
                reason ||
                "Human operator authorized the proposed simulated response."
            );


        if (
            result &&
            result.success === false
        ) {

            setHumanAuthorityStatus(
                result.message ||
                "SIMULATED RESPONSE AUTHORIZATION NOT ACCEPTED"
            );

            return result;

        }


        window.lastDPSimulation =
            result;


        updateAssessment(
            result,
            executeRecommendedActions(result),
            extractReserveVerification(result),
            result.systemSetup
        );


        updateHumanAuthorityDisplay(
            result
        );


        log(
            "SIMULATED RESPONSE AUTHORIZED THROUGH AUTHORITATIVE ENGINE"
        );


        return result;

    }


    function setHumanAuthorityStatus(
        message
    ) {

        setText(
            [
                "humanDecisionStatus",
                "humanAuthorityStatus",
                "decisionAuthorityStatus"
            ],
            message
        );


        log(
            "HUMAN AUTHORITY:",
            message
        );

    }


    /* ========================================================
       SIMULATED DP RESPONSE DISPLAY
    ======================================================== */

    function simulatedDPResponse(
        result,
        humanDecision
    ) {

        const setup =
            result?.systemSetup ||
            readSystemSetup();


        const reserve =
            extractReserveVerification(
                result
            );


        let response;


        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP
        ) {

            if (
                reserve.reserveVerified ===
                    true
            ) {

                response =
                    "PUSH-UP SIMULATION PERMITTED FOR HUMAN REVIEW";

            } else {

                response =
                    "PUSH-UP BLOCKED — RESERVE NOT VERIFIED";

            }

        } else {

            response =
                "NORMAL LOAD — HUMAN REVIEW REQUIRED";

        }


        const output = {

            executed:
                false,

            humanAuthorizationRequired:
                true,

            humanDecision:
                humanDecision ||
                null,

            realVesselConnection:
                false,

            autonomousCommand:
                false,

            simulatedOnly:
                true,

            response:
                response

        };


        setText(
            [
                "responseMode",
                "simulatedResponseMode"
            ],
            "SIMULATED DP RESPONSE"
        );


        setText(
            [
                "proposedAction",
                "simulatedProposedAction"
            ],
            response
        );


        setText(
            [
                "gate",
                "executionGate"
            ],
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !==
                true

                ? "BLOCKED — RESERVE NOT VERIFIED"

                : "HUMAN AUTHORIZATION REQUIRED"
        );


        setText(
            [
                "actionStatus",
                "simulatedActionStatus"
            ],
            "SIMULATION ONLY — NO REAL EXECUTION"
        );


        return output;

    }


    /* ========================================================
       CONTROLLER HUMAN GATE
    ======================================================== */

    function applyHumanAuthority(
        result,
        reserveVerification
    ) {

        const setup =
            result?.systemSetup ||
            readSystemSetup();


        const reserve =
            reserveVerification ||
            extractReserveVerification(
                result
            );


        const gate = {

            humanAuthorizationRequired:
                true,

            humanAuthority:
                HUMAN_AUTHORITY,

            autonomousCommand:
                false,

            realVesselConnection:
                false,

            executed:
                false,

            authorized:
                false

        };


        if (
            setup.engineLoadMode ===
                ENGINE_LOAD_MODES.PUSH_UP &&
            reserve.reserveVerified !==
                true
        ) {

            gate.blocked =
                true;

            gate.reason =
                "RESERVE NOT VERIFIED";


            gate.status =
                "BLOCKED — RESERVE NOT VERIFIED";


            return gate;

        }


        gate.status =
            "HUMAN AUTHORIZATION REQUIRED";


        return gate;

    }


    /* ========================================================
       MAIN PIPELINE
    ======================================================== */

    function runPipeline() {

        try {

            log(
                "================================================"
            );


            log(
                "STARTING DP V&V SIMULATION"
            );


            log(
                "MODULE:",
                MODULE_NAME
            );


            log(
                "VERSION:",
                VERSION
            );


            displaySafety();


            const setup =
                updateSystemSetupDisplay(
                    readSystemSetup()
                );


            const environment =
                readEnvironment();


            updateEnvironmentDisplay(
                environment
            );


            setText(
                [
                    "engineStatus",
                    "liveEngineStatus"
                ],
                "CONNECTED — RUNNING"
            );


            setText(
                [
                    "environmentStatus",
                    "liveEnvironmentStatus"
                ],
                "PROCESSING"
            );


            /*
             * AUTHORITATIVE ENGINE
             */

            const result =
                executeEngine(
                    environment
                );


            /*
             * Do NOT replace authoritative
             * engine setup.
             */

            const authoritativeSetup =
                result.systemSetup ||
                setup;


            updateSystemSetupDisplay(
                authoritativeSetup
            );


            /*
             * RECOMMENDED ACTIONS
             */

            const actions =
                executeRecommendedActions(
                    result
                );


            /*
             * RESERVE VERIFICATION
             */

            const reserveVerification =
                extractReserveVerification(
                    result
                );


            /*
             * HUMAN GATE
             */

            const humanGate =
                applyHumanAuthority(
                    result,
                    reserveVerification
                );


            /*
             * Controller-level simulated response
             * display only.
             *
             * The authoritative engine has already
             * stopped at the human decision gate.
             */

            const simulatedResponse =
                simulatedDPResponse(
                    result,
                    humanGate
                );


            /*
             * Attach interface metadata.
             *
             * These do NOT replace engine calculations.
             */

            result.humanAuthorityGate =
                humanGate;


            result.simulatedDPResponse =
                simulatedResponse;


            result.recommendedActions =
                actions;


            result.cockpitAudit = {

                module:
                    MODULE_NAME,

                version:
                    VERSION,

                timestamp:
                    new Date()
                        .toISOString(),

                systemSetup:
                    authoritativeSetup,

                reservePowerVerification:
                    reserveVerification,

                humanAuthority:
                    HUMAN_AUTHORITY,

                autonomousCommand:
                    false,

                realVesselConnection:
                    false,

                simulatedOnly:
                    true

            };


            /*
             * Update all screen sections.
             */

            updateAssessment(
                result,
                actions,
                reserveVerification,
                authoritativeSetup
            );


            /*
             * IMPORTANT:
             *
             * Keep the engine's actual human state.
             * Do not overwrite it with "NORMAL CONTROL".
             */

            setText(
                [
                    "engineStatus",
                    "liveEngineStatus"
                ],
                "CONNECTED — READY"
            );


            setText(
                [
                    "environmentStatus",
                    "liveEnvironmentStatus"
                ],
                "INPUTS PROCESSED"
            );


            setText(
                [
                    "primaryAIStatus",
                    "livePrimaryAI"
                ],
                result.primary?.mode ||
                "NORMAL CONTROL"
            );


            setText(
                [
                    "secondaryAIStatus",
                    "liveSecondaryAI"
                ],
                result.secondary?.mode ||
                "INDEPENDENT MONITORING"
            );


            setText(
                [
                    "stabilizerStatus",
                    "liveStabilizer"
                ],
                result.stabilizer?.status ||
                "STABLE"
            );


            updateHumanAuthorityDisplay(
                result
            );


            setText(
                [
                    "systemStatus",
                    "liveSystemStatus"
                ],
                "SIMULATION COMPLETE — HUMAN DECISION PENDING"
            );


            /*
             * Global research references.
             */

            window.lastDPSimulation =
                result;


            window.lastDPRecommendedActions =
                actions;


            log(
                "SIMULATION COMPLETE — PENDING HUMAN DECISION"
            );


            log(
                "AUTHORITATIVE RESERVE:",
                reserveVerification
            );


            log(
                "HUMAN AUTHORITY REMAINS FINAL"
            );


            log(
                "NO AUTONOMOUS OPERATIONAL EXECUTION"
            );


            log(
                "================================================"
            );


            return result;

        } catch (error) {

            console.error(
                "[Sextant DP Cockpit] SIMULATION ERROR:",
                error
            );


            setText(
                [
                    "engineStatus",
                    "liveEngineStatus"
                ],
                "ENGINE ERROR"
            );


            setText(
                [
                    "systemStatus",
                    "liveSystemStatus"
                ],
                "SIMULATION ERROR"
            );


            setText(
                [
                    "executionStatus",
                    "liveExecutionStatus"
                ],
                "HUMAN AUTHORIZATION REQUIRED"
            );


            setText(
                [
                    "assessmentOutput",
                    "assessmentResult"
                ],
                "SIMULATION ERROR\n\n" +
                error.message
            );


            setText(
                [
                    "auditOutput",
                    "auditResult"
                ],
                safeJSON({

                    module:
                        MODULE_NAME,

                    version:
                        VERSION,

                    error:
                        error.message,

                    timestamp:
                        new Date()
                            .toISOString()

                })
            );


            return null;

        }

    }


