            ],
            authorizeSimulatedResponse
        );


        wireScenarioButtons();

        wireSystemSetup();

    }


    /* ========================================================
       WIRING VALIDATION
    ======================================================== */

    function validateWiring() {

        const simulationEngine =
            discoverSimulationEngine();


        const recommendedActions =
            discoverRecommendedActionsEngine();


        const setup =
            readSystemSetup();


        const validation = {

            module:
                MODULE_NAME,

            version:
                VERSION,

            simulationEngineConnected:
                !!simulationEngine,

            simulationEngineVersion:
                simulationEngine?.version ||
                SIMULATION_ENGINE_VERSION,

            simulationEngineRun:
                !!(
                    simulationEngine &&
                    typeof
                        simulationEngine.run ===
                            "function"
                ),

            humanAcknowledgeAPI:
                !!(
                    simulationEngine &&
                    typeof
                        simulationEngine
                            .acknowledgeHumanDecision ===
                            "function"
                ),

            humanMaintainSafeStateAPI:
                !!(
                    simulationEngine &&
                    typeof
                        simulationEngine
                            .maintainSafeState ===
                            "function"
                ),

            humanAuthorizeAPI:
                !!(
                    simulationEngine &&
                    typeof
                        simulationEngine
                            .authorizeSimulatedResponse ===
                            "function"
                ),

            recommendedActionsConnected:
                !!recommendedActions,

            recommendedActionsVersion:
                recommendedActions?.version ||
                RECOMMENDED_ACTIONS_VERSION,

            positioningMode:
                setup.positioningMode,

            engineLoadMode:
                setup.engineLoadMode,

            pushUpIsPositioningBias:
                false,

            reserveVerificationRequiredForPushUp:
                true,

            humanAuthority:
                HUMAN_AUTHORITY,

            autonomousCommand:
                false,

            realVesselConnection:
                false,

            safetyBoundary:
                SAFETY_BOUNDARY,

            pipeline:
                PIPELINE.slice()

        };


        log(
            "WIRING VALIDATION:",
            validation
        );


        setText(
            [
                "engineStatus",
                "liveEngineStatus"
            ],
            validation.simulationEngineConnected &&
            validation.simulationEngineRun

                ? "CONNECTED — READY"

                : "NOT CONNECTED"
        );


        return validation;

    }


    function testRecommendedActionsConnection() {

        const engine =
            retryRecommendedActionsEngine();


        const result = {

            connected:
                !!engine,

            version:
                engine?.version ||
                RECOMMENDED_ACTIONS_VERSION

        };


        log(
            "RECOMMENDED ACTIONS TEST:",
            result
        );


        return result;

    }


    /* ========================================================
       PUBLIC API
    ======================================================== */

    window.runDPCockpit =
        runPipeline;


    window.runDPSimulation =
        runPipeline;


    window.executeDPSimulation =
        runPipeline;


    /*
     * BACKWARD COMPATIBILITY
     */

    window.runSimulation =
        runPipeline;


    window.resetDPCockpit =
        resetCockpit;


    window.resetSimulation =
        resetCockpit;


    window.validateDPWiring =
        validateWiring;


    window.testDPEngineConnection =
        validateWiring;


    window.testRecommendedActionsConnection =
        testRecommendedActionsConnection;


    window.DPCockpit = {

        module:
            MODULE_NAME,

        version:
            VERSION,

        simulationEngineVersion:
            SIMULATION_ENGINE_VERSION,

        recommendedActionsVersion:
            RECOMMENDED_ACTIONS_VERSION,

        run:
            runPipeline,

        reset:
            resetCockpit,

        validate:
            validateWiring,

        safety:
            SAFETY_BOUNDARY,

        humanAuthority:
            HUMAN_AUTHORITY,

        autonomousCommand:
            AUTONOMOUS_COMMAND,

        realVesselConnection:
            REAL_VESSEL_CONNECTION,

        positioningModes:
            POSITIONING_MODES,

        engineLoadModes:
            ENGINE_LOAD_MODES,

        scenarios: {

            normal:
                normalScenario,

            moderateWeather:
                moderateWeatherScenario,

            heavyWeather:
                heavyWeatherScenario,

            critical:
                criticalScenario,

            currentSurge:
                currentSurgeScenario,

            heavySeaState:
                heavySeaStateScenario,

            windGust:
                windGustScenario,

            combinedDisturbance:
                combinedDisturbanceScenario,

            random:
                randomScenario

        },

        humanAuthorityActions: {

            acknowledge:
                acknowledgeCondition,

            maintainSafeState:
                maintainSafeState,

            authorizeSimulatedResponse:
                authorizeSimulatedResponse

        },

        pipeline:
            PIPELINE.slice()

    };


    /* ========================================================
       BOOT
    ======================================================== */

    function boot() {

        log(
            "================================================"
        );


        log(
            MODULE_NAME +
            " v" +
            VERSION +
            " BOOT"
        );


        log(
            "SAFETY:",
            SAFETY_BOUNDARY
        );


        log(
            "HUMAN AUTHORITY:",
            HUMAN_AUTHORITY
        );


        log(
            "AUTONOMOUS COMMAND:",
            AUTONOMOUS_COMMAND
        );


        log(
            "REAL VESSEL CONNECTION:",
            REAL_VESSEL_CONNECTION
        );


        log(
            "BIAS = POSITIONING ONLY"
        );


        log(
            "PUSH-UP = ENGINE LOAD COMPENSATION ONLY"
        );


        log(
            "PUSH-UP ≠ POSITIONING BIAS"
        );


        log(
            "PUSH-UP REQUIRES RESERVE-POWER VERIFICATION"
        );


        displaySafety();


        /*
         * Compatibility aliases.
         */

        window.runSimulation =
            runPipeline;


        window.resetSimulation =
            resetCockpit;


        /*
         * Wire interface.
         */

        wireUI();


        /*
         * Validate authoritative engine.
         */

        validateWiring();


        /*
         * Connect recommended actions.
         */

        retryRecommendedActionsEngine();


        /*
         * Initial system setup.
         */

        updateSystemSetupDisplay(
            readSystemSetup()
        );


        /*
         * IMPORTANT:
         *
         * Initial reserve state is NOT VERIFIED.
         *
         * It becomes authoritative only after
         * the simulation engine has run.
         */

        updateReservePowerDisplay({

            reserveVerified:
                false,

            availableReserve:
                null,

            requiredReserve:
                0,

            status:
                "NOT VERIFIED"

        });


        setText(
            [
                "systemStatus",
                "liveSystemStatus"
            ],
            "READY"
        );


        setText(
            [
                "environmentStatus",
                "liveEnvironmentStatus"
            ],
            "WAITING"
        );


        setText(
            [
                "executionStatus",
                "liveExecutionStatus"
            ],
            "HUMAN AUTHORIZATION REQUIRED"
        );


        log(
            "COCKPIT READY"
        );


        log(
            "AUTHORITATIVE ENGINE:",
            SIMULATION_ENGINE_VERSION
        );


        log(
            "HUMAN DECISION API: CONNECTED THROUGH ENGINE"
        );


        log(
            "================================================"
        );

    }


    /* ========================================================
       START
    ======================================================== */

    if (
        document.readyState ===
            "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            boot
        );

    } else {

        boot();

    }


})();