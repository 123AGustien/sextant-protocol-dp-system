    function wireButton(
        ids,
        handler
    ) {
        const button =
            firstById(
                Array.isArray(ids)
                    ? ids
                    : [ids]
            );

        if (!button) {
            return false;
        }

        /*
         * Prevent duplicate listeners when the
         * controller is initialized more than once.
         */
        if (
            button.dataset &&
            button.dataset.sextantWired === "true"
        ) {
            return true;
        }

        button.addEventListener(
            "click",
            function (event) {
                event.preventDefault();
                handler(event);
            }
        );

        if (button.dataset) {
            button.dataset.sextantWired = "true";
        }

        return true;
    }


