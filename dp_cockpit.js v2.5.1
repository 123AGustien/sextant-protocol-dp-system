    function wireSystemSetup() {

        const positioning =
            firstById([
                "positioningMode",
                "positionMode",
                "biasMode"
            ]);


        const load =
            firstById([
                "engineLoadMode",
                "loadMode",
                "engineMode"
            ]);


        if (positioning) {

            positioning.addEventListener(
                "change",
                function () {

                    updateSystemSetupDisplay(
                        readSystemSetup()
                    );

                }
            );

        }


        if (load) {

            load.addEventListener(
                "change",
                function () {

                    const setup =
                        readSystemSetup();


                    updateSystemSetupDisplay(
                        setup
                    );


                    /*
                     * PUSH-UP selection invalidates
                     * previous reserve verification.
                     *
                     * No assumption of reserve is made.
                     */

                    if (
                        setup.engineLoadMode ===
                            ENGINE_LOAD_MODES.PUSH_UP
                    ) {

                        updateReservePowerDisplay({

                            reserveVerified:
                                false,

                            availableReserve:
                                null,

                            requiredReserve:
                                15,

                            status:
                                "AWAITING AUTHORITATIVE VERIFICATION"

                        });


                        setText(
                            [
                                "executionStatus",
                                "liveExecutionStatus"
                            ],
                            "PUSH-UP SELECTED — RESERVE VERIFICATION REQUIRED"
                        );

                    }

                }
            );

        }

    }


    function wireUI() {

        /*
         * MAIN RUN
         */

        wireButton(
            [
                "runSimulation",
                "runSimulationButton",
                "runVvSimulation",
                "runDPButton",
                "simulateButton",
                "startSimulation"
            ],
            runPipeline
        );


        /*
